{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["vite/client"]
  },
  "vueCompilerOptions": { "target": 2.7 },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
