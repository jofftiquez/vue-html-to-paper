{
  "name": "vue-html-to-paper",
  "version": "2.0.3",
  "description": "Vue 2 and Vue 3 plugin for printing html elements to paper.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "types/index.d.ts",
  "unpkg": "build/vue-html-to-paper.min.js",
  "jsdelivr": "build/vue-html-to-paper.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "build",
    "types"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "eslint --fix .",
    "prebuild": "rm -rf dist build",
    "build": "rollup -c",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycurelabs/vue-html-to-paper.git"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "nuxt",
    "html",
    "printing",
    "element",
    "print html",
    "print element"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "rollup": "^4.63.6"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "author": "Jofferson Ramirez Tiquez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mycurelabs/vue-html-to-paper/issues"
  },
  "homepage": "https://github.com/mycurelabs/vue-html-to-paper#readme"
}
